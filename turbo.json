{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    "tsconfig.base.json",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "crates/fict-*/Cargo.toml",
    "crates/fict-*/build.rs",
    "crates/fict-*/src/**",
    "diagnostics/registry.json",
    "packages/compiler/compiler-capabilities.json",
    "scripts/run-turbo.mjs",
    "scripts/prepare-native-compiler-addon.mjs",
    "scripts/native-compiler-packages.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**", "lib/**", "types/**", "build/**", "docs/.vitepress/dist/**"],
      "env": ["NODE_ENV", "FICT_STRICT_GUARANTEE"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "@fictjs/playground#typecheck": {
      "dependsOn": [
        "@fictjs/compiler#build",
        "@fictjs/vite-plugin#build",
        "@fictjs/devtools#build"
      ],
      "outputs": []
    },
    "@fictjs/vite-plugin#typecheck": {
      "dependsOn": ["@fictjs/compiler#build"],
      "outputs": []
    },
    "@fictjs/vscode-extension#typecheck": {
      "dependsOn": ["@fictjs/compiler#build"],
      "outputs": []
    },
    "@fictjs/webpack-plugin#typecheck": {
      "dependsOn": ["@fictjs/compiler#build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  },
  "globalEnv": ["FICT_COMPILER_ARTIFACT_HASH"],
  "globalPassThroughEnv": ["FICT_COMPILER_NATIVE_PATH"]
}
