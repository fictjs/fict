{
  "name": "@fictjs/skill",
  "version": "0.17.0",
  "description": "Skill library for Fict-focused coding agents",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "skills",
    "scripts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fictjs/fict.git",
    "directory": "packages/skill"
  },
  "scripts": {
    "build": "pnpm run build:skills && tsup",
    "build:skills": "node scripts/build-skills.mjs",
    "build:skills:check": "node scripts/build-skills.mjs --check",
    "validate:skills": "node scripts/validate-skills.mjs",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "yaml": "^2.8.3"
  },
  "keywords": [
    "fict",
    "skill",
    "agents",
    "compiler",
    "runtime"
  ],
  "author": "unadlib",
  "license": "MIT"
}
