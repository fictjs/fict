{
  "name": "@fictjs/playground",
  "version": "0.9.0",
  "private": true,
  "description": "Full-featured local playground for Fict compiler/runtime workflows",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fict-playground": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fictjs/fict.git",
    "directory": "packages/playground"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .fict-playground"
  },
  "dependencies": {
    "@fictjs/compiler": "workspace:*",
    "@fictjs/devtools": "workspace:*",
    "@fictjs/vite-plugin": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "tsdown": "^0.22.12",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "fict",
    "playground",
    "compiler",
    "runtime",
    "diagnostics"
  ],
  "author": "unadlib",
  "license": "MIT"
}
