{
  "name": "@fictjs/babel-preset",
  "version": "0.30.1",
  "description": "Babel preset for Fict - includes TypeScript, JSX, and Fict compiler",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src",
    "typecheck": "echo 'Types checked via dependencies'",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0-0"
  },
  "dependencies": {
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/plugin-transform-typescript": "^8.0.1",
    "@fictjs/compiler": "workspace:*",
    "@types/babel__core": "^7.20.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "tsdown": "^0.22.3"
  },
  "keywords": [
    "babel-preset",
    "fict",
    "jsx",
    "typescript",
    "reactive"
  ],
  "author": "unadlib",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fictjs/fict.git",
    "directory": "packages/babel-preset"
  }
}
