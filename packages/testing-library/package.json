{
  "name": "@fictjs/testing-library",
  "version": "0.28.0",
  "description": "Testing utilities for Fict components, built on @testing-library/dom",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fictjs/fict.git",
    "directory": "packages/testing-library"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.1"
  },
  "peerDependencies": {
    "@fictjs/runtime": ">=0.3.0"
  },
  "devDependencies": {
    "@fictjs/compiler": "workspace:*",
    "@fictjs/runtime": "workspace:*",
    "@fictjs/vite-plugin": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^26.1.1",
    "jsdom": "^29.1.1",
    "tsdown": "^0.22.9",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "fict",
    "testing",
    "testing-library",
    "test",
    "unit-test",
    "ui",
    "dom"
  ],
  "author": "unadlib",
  "license": "MIT"
}
