{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@fictjs/compiler": ["../compiler/dist/index.d.ts"],
      "@fictjs/compiler/*": ["../compiler/dist/*"]
    },
    "lib": ["ES2020"],
    "outDir": "dist",
    "types": ["node", "vscode", "vitest/globals"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
