{
  "name": "@fictjs/eslint-plugin",
  "version": "0.32.0-next.0",
  "description": "ESLint plugin for Fict",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fictjs/fict.git",
    "directory": "packages/eslint-plugin"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.0.0",
    "@types/estree": "^1.0.9",
    "eslint": "^10.7.0",
    "tsdown": "^0.22.12"
  },
  "keywords": [
    "fict",
    "eslint",
    "eslint-plugin",
    "linting",
    "reactive"
  ],
  "author": "unadlib",
  "license": "MIT"
}
