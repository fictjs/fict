[
  {
    "name": "state derived alias chain",
    "language": "tsx",
    "source": "import { $state as state } from 'fict'; export function Counter() { const count = state(0); const active = count !== 0; const alias = active; return alias; }",
    "expected": {
      "functions": [
        {
          "name": "Counter",
          "reactiveBindings": [
            { "name": "active", "kind": "derived", "dependencies": ["count"] },
            { "name": "alias", "kind": "alias", "dependencies": ["active"] },
            { "name": "count", "kind": "state", "dependencies": [] }
          ],
          "controlFlowReads": [],
          "escapingBindings": ["active", "alias", "count"],
          "shapes": [],
          "region": { "hasControlFlow": false, "hasJsx": false, "hasAsync": false },
          "hasEffect": false
        }
      ],
      "hasDerivedCycle": false
    }
  },
  {
