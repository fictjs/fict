// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`optimizer output snapshots > createMemo with equals option 1`] = `
"import { __fictUseSignal, __fictUseContext } from "fict/internal";
import { createMemo } from 'fict';
export function Demo() {
  const __fictCtx = __fictUseContext();
  const count = __fictUseSignal(__fictCtx, {
    value: 0
  }, {
    name: "count"
  });
  const memoized = createMemo(() => ({
    doubled: count().value * 2
  }), {
    equals: (prev, next) => prev.doubled === next.doubled
  });
  return memoized().doubled;
}"
`;

