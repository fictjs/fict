{
  "name": "@fictjs/compiler",
  "version": "0.30.1",
  "description": "Babel plugin for Fict Compiler",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "unadlib",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fictjs/fict.git",
    "directory": "packages/compiler"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./graph-host": {
      "import": {
        "types": "./dist/graph-host.d.ts",
        "default": "./dist/graph-host.js"
      },
      "require": {
        "types": "./dist/graph-host.d.cts",
        "default": "./dist/graph-host.cjs"
      }
    },
    "./legacy": {
      "import": {
        "types": "./dist/legacy.d.ts",
        "default": "./dist/legacy.js"
      },
      "require": {
        "types": "./dist/legacy.d.cts",
        "default": "./dist/legacy.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native-loader.d.ts",
        "default": "./dist/native-loader.js"
      },
      "require": {
        "types": "./dist/native-loader.d.cts",
        "default": "./dist/native-loader.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:differential": "vitest run test/differential",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0-0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/helper-plugin-utils": "^7.28.6",
    "@babel/plugin-transform-destructuring": "^7.27.1",
    "@babel/plugin-transform-typescript": "^7.28.5",
    "@babel/traverse": "^7.29.0",
    "@oxc-project/runtime": "0.139.0",
    "@types/babel__core": "^7.20.5"
  },
  "optionalDependencies": {
    "@fictjs/compiler-darwin-arm64": "workspace:*",
    "@fictjs/compiler-darwin-x64": "workspace:*",
    "@fictjs/compiler-linux-arm64-gnu": "workspace:*",
    "@fictjs/compiler-linux-arm64-musl": "workspace:*",
    "@fictjs/compiler-linux-x64-gnu": "workspace:*",
    "@fictjs/compiler-linux-x64-musl": "workspace:*",
    "@fictjs/compiler-win32-arm64-msvc": "workspace:*",
    "@fictjs/compiler-win32-x64-msvc": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/generator": "^7.29.1",
    "@babel/plugin-syntax-jsx": "^7.28.6",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@babel/types": "^7.29.0",
    "@fictjs/runtime": "workspace:*",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/babel__helper-plugin-utils": "^7.10.3",
    "@types/babel__traverse": "^7.28.0",
    "tsdown": "^0.22.3"
  }
}
