{
  "name": "@fictjs/compiler",
  "version": "0.32.0-next.0",
  "description": "OXC/Rust compiler for Fict",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "unadlib",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fictjs/fict.git",
    "directory": "packages/compiler"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./graph-host": {
      "import": {
        "types": "./dist/graph-host.d.ts",
        "default": "./dist/graph-host.js"
      },
      "require": {
        "types": "./dist/graph-host.d.cts",
        "default": "./dist/graph-host.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native-loader.d.ts",
        "default": "./dist/native-loader.js"
      },
      "require": {
        "types": "./dist/native-loader.d.cts",
        "default": "./dist/native-loader.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oxc-project/runtime": "0.139.0"
  },
  "optionalDependencies": {
    "@fictjs/compiler-darwin-arm64": "workspace:*",
    "@fictjs/compiler-darwin-x64": "workspace:*",
    "@fictjs/compiler-linux-arm64-gnu": "workspace:*",
    "@fictjs/compiler-linux-arm64-musl": "workspace:*",
    "@fictjs/compiler-linux-x64-gnu": "workspace:*",
    "@fictjs/compiler-linux-x64-musl": "workspace:*",
    "@fictjs/compiler-win32-arm64-msvc": "workspace:*",
    "@fictjs/compiler-win32-x64-msvc": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.22.12"
  }
}
