{
  "name": "@fictjs/vite-plugin",
  "version": "0.28.0",
  "description": "Vite plugin for Fict",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fictjs/fict.git",
    "directory": "packages/vite-plugin"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "vite": ">=7.0.0"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-transform-typescript": "^8.0.1",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@fictjs/compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "tsdown": "^0.22.3",
    "vite": "^8.1.4"
  },
  "keywords": [
    "fict",
    "vite",
    "vite-plugin",
    "jsx",
    "reactive"
  ],
  "author": "unadlib",
  "license": "MIT"
}
