{
  "name": "@fictjs/vite-plugin",
  "version": "0.32.0-next.0",
  "description": "Vite plugin for Fict",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fictjs/fict.git",
    "directory": "packages/vite-plugin"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "vite": ">=7.0.0"
  },
  "dependencies": {
    "@fictjs/compiler": "workspace:*",
    "@jridgewell/remapping": "^2.3.5",
    "magic-string": "^1.1.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.3",
    "vite": "^8.2.1"
  },
  "keywords": [
    "fict",
    "vite",
    "vite-plugin",
    "jsx",
    "reactive"
  ],
  "author": "unadlib",
  "license": "MIT"
}
