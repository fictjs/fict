{
  "name": "@fictjs/mcp",
  "version": "0.12.0",
  "description": "MCP server for Fict",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fict-mcp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fictjs/fict.git",
    "directory": "packages/mcp"
  },
  "scripts": {
    "build:assets": "node scripts/generate-available-docs.mjs",
    "build": "node scripts/generate-available-docs.mjs && tsup",
    "dev": "node scripts/generate-available-docs.mjs && tsup --watch",
    "start": "node dist/bin.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@babel/core": "^7.28.6",
    "@babel/plugin-syntax-jsx": "^7.28.6",
    "@babel/preset-typescript": "^7.26.0",
    "@fictjs/compiler": "workspace:^",
    "@fictjs/eslint-plugin": "workspace:^",
    "@fictjs/playground": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "fict",
    "mcp"
  ],
  "author": "unadlib",
  "license": "MIT"
}
