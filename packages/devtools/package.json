{
  "name": "@fictjs/devtools",
  "version": "0.3.0",
  "private": true,
  "description": "Developer tools for Fict applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fictjs/fict.git",
    "directory": "packages/devtools"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "build"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "pnpm build:lib && pnpm build:extension",
    "build:lib": "tsdown",
    "build:extension": "vite build && vite build --config vite.page.config.ts",
    "build:chrome": "vite build --mode chrome && vite build --config vite.page.config.ts --mode chrome",
    "build:firefox": "vite build --mode firefox && vite build --config vite.page.config.ts --mode firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist build"
  },
  "dependencies": {
    "@fictjs/runtime": "workspace:*",
    "open": "^11.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/ws": "^8.18.1",
    "jsdom": "^30.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "keywords": [
    "fict",
    "devtools",
    "debugging",
    "reactive",
    "signals"
  ],
  "author": "unadlib",
  "license": "MIT"
}
