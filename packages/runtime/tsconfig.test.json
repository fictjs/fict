{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noUncheckedIndexedAccess": false,
    "strictFunctionTypes": false,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "test/async-state.test.ts",
    "test/async-memo.test.ts",
    "test/list-helpers.test.ts",
    "test/binding-edge-cases.test.ts",
    "test/runtime-abi.test.ts",
    "../compiler/src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
