{
  "name": "@fictjs/ssr",
  "version": "0.33.0",
  "description": "Fict server-side rendering",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fictjs/fict.git",
    "directory": "packages/ssr"
  },
  "type": "module",
  "main": "dist/index.node.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "import": "./dist/index.node.js",
        "require": "./dist/index.node.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "node": {
        "import": "./dist/experimental.node.js",
        "require": "./dist/experimental.node.cjs"
      },
      "import": "./dist/experimental.js",
      "require": "./dist/experimental.cjs"
    },
    "./stream-runtime": {
      "types": "./dist/stream-runtime.d.ts",
      "import": "./dist/stream-runtime.js",
      "require": "./dist/stream-runtime.cjs"
    },
    "./fict-stream-runtime.js": "./dist/fict-stream-runtime.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && pnpm run build:stream-runtime",
    "build:stream-runtime": "node scripts/write-stream-runtime-asset.mjs",
    "dev": "tsdown --watch --on-success \"pnpm run build:stream-runtime\"",
    "test": "vitest run",
    "test:node": "node test/node-runtime.smoke.mjs",
    "test:edge": "node test/edge-runtime.smoke.mjs",
    "test:cjs": "node test/cjs-runtime.smoke.cjs",
    "test:matrix": "pnpm run test && pnpm run test:node && pnpm run test:edge && pnpm run test:cjs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fictjs/runtime": "workspace:^",
    "linkedom": "^0.18.12"
  },
  "devDependencies": {
    "fict": "workspace:*",
    "tsdown": "^0.22.3"
  },
  "keywords": [
    "fict",
    "ssr",
    "server-side-rendering",
    "isomorphic",
    "reactive"
  ],
  "author": "unadlib",
  "license": "MIT"
}
