{
  "name": "fict-example-hook-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./toggle": {
      "import": "./dist/toggle.js",
      "require": "./dist/toggle.cjs"
    }
  },
  "fict": {
    "exports": {
      ".": "./dist/index.fict.meta.json",
      "./toggle": "./dist/toggle.fict.meta.json"
    }
  },
  "scripts": {
    "build": "vite build",
    "pack:dry": "pnpm build && npm pack --dry-run"
  },
  "peerDependencies": {
    "fict": ">=0.19.0"
  },
  "devDependencies": {
    "@fictjs/vite-plugin": "workspace:*",
    "fict": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
