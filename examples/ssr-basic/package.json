{
  "name": "fict-example-ssr-basic",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.tsx",
    "preview": "NODE_ENV=production node server.js"
  },
  "dependencies": {
    "fict": "workspace:*",
    "@fictjs/runtime": "workspace:*",
    "@fictjs/ssr": "workspace:*",
    "@fictjs/vite-plugin": "workspace:*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.4"
  }
}
